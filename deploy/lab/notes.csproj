<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Paquete para el PaaS del laboratorio: el PaaS busca un único csproj en la raíz.
       Compila el host (src/AdminServices.WebApi) y referencia las demás capas como proyectos normales.
       Versiones de paquetes: Directory.Packages.props (gestión central), copiado junto a este archivo. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AdminServices.WebApi</AssemblyName>
    <RootNamespace>AdminServices.WebApi</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/AdminServices.WebApi/**/*.cs" Exclude="src/AdminServices.WebApi/bin/**;src/AdminServices.WebApi/obj/**" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="wwwroot/**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="src/AdminServices.Application/AdminServices.Application.csproj" />
    <ProjectReference Include="src/AdminServices.Infrastructure/AdminServices.Infrastructure.csproj" />
    <ProjectReference Include="src/AdminServices.Presentation/AdminServices.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="System.Formats.Asn1" />
  </ItemGroup>
</Project>
